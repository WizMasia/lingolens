{
  "manifest_version": 3,
  "name": "Local Page Translator",
  "version": "0.1.0",
  "description": "Private, on-device page translation for Chrome.",
  "minimum_chrome_version": "138",
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"]
    }
  ]
}
